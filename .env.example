# Use `true` to preview the complete admin UI without Supabase credentials.
# Demo mode never writes data and must be disabled for production use.
DEMO_MODE=true

# Safe to expose to the browser. Never use the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public URL. Use the Vercel preview URL while validating the prototype.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
