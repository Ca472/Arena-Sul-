# Use `true` to preview the complete admin UI without Supabase credentials.
# Demo mode never writes data and must be disabled for production use.
DEMO_MODE=true

# Safe to expose to the browser. Never use the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. This key is used by the isolated Instagram token store and to
# authorize versioned site-photo uploads. Never expose it to the browser or
# prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL. Use the Vercel preview URL while validating the prototype.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Instagram Business Login configuration.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=https://arena-sul-portal.vercel.app/api/instagram/oauth/callback
INSTAGRAM_EXPECTED_USERNAME=arenasulsports
# Base64-encoded 32-byte AES key. Generate securely; do not reuse the app secret.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_GRAPH_VERSION=v26.0
